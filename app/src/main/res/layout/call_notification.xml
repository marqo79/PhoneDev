<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notification_holder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="#fff">

    <LinearLayout
        android:id="@+id/notification_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignWithParentIfMissing="true"
        android:layout_toEndOf="@+id/notification_thumbnail"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notification_caller_name"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textDirection="firstStrongLtr"
            android:textSize="@dimen/bigger_text_size"
            android:textStyle="bold"
            tools:text="Caller name" />

        <LinearLayout
            android:id="@+id/notification_metadata"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="end"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/notification_sim_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="90dp"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:visibility="gone" />

            <Chronometer
                android:id="@+id/notification_timer"
                style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/notification_call_status"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/notification_header"
        android:layout_toEndOf="@id/notification_thumbnail"
        android:alpha="0.8"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="14sp"
        tools:text="123 456 789" />

    <FrameLayout
        android:id="@+id/notification_thumbnail"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginEnd="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/notification_caller_photo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|start"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/notification_phone_badge"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_gravity="bottom|right"
            android:contentDescription="@null"
            android:src="@drawable/notification_avatar_phone" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/notification_actions_holder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/notification_call_status"
        android:layout_alignParentEnd="true"
        android:layout_alignWithParentIfMissing="true"
        android:layout_toEndOf="@id/notification_thumbnail"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notification_speaker"
            android:layout_width="0dp"
            android:layout_height="@dimen/call_notification_button_size"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/notification_microphone"
            android:layout_width="0dp"
            android:layout_height="@dimen/call_notification_button_size"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/notification_decline_call"
            android:layout_width="0dp"
            android:layout_height="@dimen/call_notification_button_size"
            android:layout_weight="1"
            android:background="@drawable/ripple_background"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_phone_down_red_vector" />

        <ImageView
            android:id="@+id/notification_accept_call"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/call_notification_button_size"
            android:layout_weight="1"
            android:background="@drawable/ripple_background"
            android:contentDescription="@string/accept_call"
            android:padding="@dimen/small_margin"
            android:src="@drawable/ic_phone_green_vector" />

    </LinearLayout>
</RelativeLayout>
